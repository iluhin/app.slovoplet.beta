<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1">
<title>Словоплёт — Угадай слово за 5 попыток</title>
<meta name="description" content="Угадай слово за 5 попыток">
<meta name="theme-color" content="#0a0c1f">
<link rel="icon" href="assets/icons/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="assets/icons/icon-192.png" sizes="192x192" type="image/png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Словоплёт">
<meta name="mobile-web-app-capable" content="yes">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Rubik:wght@500;700;800&display=swap&subset=cyrillic" rel="stylesheet">
<link rel="stylesheet" href="assets/game.css">
<script>
(function(){try{var t=localStorage.getItem('five_theme');var ok=['aurora','midnight','sunset','candy','matcha','contrast'];
var d="aurora",sw=1;
document.documentElement.setAttribute('data-theme',(sw&&t&&ok.indexOf(t)>-1)?t:d);}catch(e){document.documentElement.setAttribute('data-theme',"aurora");}})();
</script>
</head>
<body class="">

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-trophy" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2z"/></symbol>
  <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></symbol>
  <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 10.6 12 3l9 7.6V20a1 1 0 0 1-1 1h-5v-6.5H10V21H4a1 1 0 0 1-1-1z"/></symbol>
  <symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></symbol>
  <symbol id="i-user" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></symbol>
  <symbol id="i-palette" viewBox="0 0 24 24"><path d="M12 22a10 10 0 1 1 10-10c0 3-2 4-4 4h-2a2 2 0 0 0-1.5 3.3c.6.7.3 2.7-2.5 2.7z"/><path d="M7.5 11h.01M11 7.5h.01M15.5 8.5h.01"/></symbol>
  <symbol id="i-vol" viewBox="0 0 24 24"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"/></symbol>
  <symbol id="i-mute" viewBox="0 0 24 24"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="m22 9-6 6M16 9l6 6"/></symbol>
  <symbol id="i-max" viewBox="0 0 24 24"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
  <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
  <symbol id="i-flame" viewBox="0 0 24 24"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM18 9l-6 6M12 9l6 6"/></symbol>
  <symbol id="i-eye" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></symbol>
  <symbol id="i-share" viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/></symbol>
  <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></symbol>
  <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></symbol>
  <symbol id="i-out" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></symbol>
  <symbol id="i-play" viewBox="0 0 24 24"><path d="m6 3 14 9-14 9V3z"/></symbol>
  <symbol id="i-enter" viewBox="0 0 24 24"><path d="m9 10-5 5 5 5M20 4v7a4 4 0 0 1-4 4H4"/></symbol>
  <symbol id="i-dl" viewBox="0 0 24 24"><path d="M12 3v12M7 11l5 5 5-5M4 20h16"/></symbol>
  <symbol id="i-phone" viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></symbol>
  <symbol id="i-flag" viewBox="0 0 24 24"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1zM4 22v-7"/></symbol>
</svg>

<div class="bg" id="bg" aria-hidden="true"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div><div class="grain"></div></div>

<div id="app">
  <header class="top">
    <div class="brand">
      <button type="button" class="logo mark" id="b-home" title="На главную" aria-label="На главную"></button>
      <div><h1 data-cfg="title">Словоплёт</h1><p data-cfg="tagline">Угадай слово за 5 попыток</p></div>
    </div>
    <div class="actions">
      <button class="ibtn" id="b-lb" title="Рейтинг" aria-label="Рейтинг"><svg class="i" aria-hidden="true"><use href="#i-trophy"/></svg></button>
      <button class="ibtn" id="b-user" title="Профиль" aria-label="Профиль"><svg class="i" aria-hidden="true"><use href="#i-user"/></svg></button>
      <button class="ibtn" id="b-theme" title="Тема" aria-label="Тема" hidden><svg class="i" aria-hidden="true"><use href="#i-palette"/></svg></button>
      <button class="ibtn" id="b-sound" title="Звук" aria-label="Звук"><svg class="i"><use href="#i-vol"/></svg></button>
      <button class="ibtn" id="b-help" title="Как играть" aria-label="Как играть"><svg class="i" aria-hidden="true"><use href="#i-help"/></svg></button>
    </div>
  </header>

  <button class="offbar" id="offbar" type="button" hidden aria-live="polite">
    <span class="dot" aria-hidden="true"></span><span id="offbar-t">Офлайн · без рейтинга</span>
  </button>

  <div class="instbar msgbar" id="msgbar" hidden>
    <span class="ic" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-info"/></svg></span>
    <span class="t" id="msgbar-t"></span>
    <a class="go" id="msgbar-go" target="_blank" rel="noopener" hidden></a>
    <button type="button" class="x" id="msgbar-x" aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  </div>

  <div class="instbar" id="instbar" hidden>
    <span class="ic" aria-hidden="true"><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg></span>
    <span class="t">Поставьте игру на телефон</span>
    <button type="button" class="go" id="inst-open">Установить</button>
    <button type="button" class="x" id="inst-hide" aria-label="Больше не предлагать"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  </div>

  <!-- Витрина: первый экран для новичка и «домой» для всех остальных -->
  <div class="home" id="home" hidden>
    <div class="home-intro">
      <p class="home-kicker" id="home-kicker">Пять букв. Одно слово.</p>
      <h2 class="home-title" id="home-title">Сплетём ещё одно слово?</h2>
      <p class="home-sub" id="home-sub">Наберите слово. Цвета подскажут, какие буквы на своём месте.</p>
    </div>
    <div class="home-demo" id="home-demo" aria-hidden="true">
      <div class="hd-r">
        <div class="tile" style="--i:0" data-d="c">К</div><div class="tile" style="--i:1" data-d="a">Н</div><div class="tile" style="--i:2" data-d="p">И</div><div class="tile" style="--i:3" data-d="a">Г</div><div class="tile" style="--i:4" data-d="a">А</div>
      </div>
      <div class="hd-r hd-b">
        <div class="tile" style="--i:0">К</div><div class="tile" style="--i:1">И</div><div class="tile" style="--i:2">С</div><div class="tile" style="--i:3">Т</div><div class="tile" style="--i:4">Ь</div>
      </div>
      <p class="home-cap" id="home-cap">Подсказки первой попытки → верное слово</p>
    </div>
    <div class="home-acts">
      <button class="btn primary block hbig" id="h-play"><svg class="i" aria-hidden="true"><use href="#i-play"/></svg> <span id="h-play-t">Играть</span></button>
      <p class="home-stat" id="home-stat"></p>
    </div>
    <div class="home-nav">
      <button class="hbtn" id="h-daily" hidden><svg class="i" aria-hidden="true"><use href="#i-clock"/></svg> Слово дня</button>
      <button class="hbtn" id="h-lb"><svg class="i" aria-hidden="true"><use href="#i-trophy"/></svg> Рейтинг</button>
      <button class="hbtn" id="h-me"><svg class="i" aria-hidden="true"><use href="#i-user"/></svg> Профиль</button>
      <button class="hbtn" id="h-help"><svg class="i" aria-hidden="true"><use href="#i-help"/></svg> Как играть</button>
    </div>
    <div class="home-foot">
      <span id="home-ver"></span>
      <button type="button" class="linkbtn" id="h-inst" hidden><svg class="i" aria-hidden="true"><use href="#i-phone"/></svg> Поставить на телефон</button>
    </div>
  </div>

  <div class="play">
  <div class="hud">
    <div class="chip" id="timer"><svg class="i" aria-hidden="true"><use href="#i-clock"/></svg><span id="timer-t">00:00</span></div>
    <div class="chip pips" id="pips" title="Попытки"></div>
    <button class="chip clickable streak" id="streak" hidden><svg class="i" aria-hidden="true"><use href="#i-flame"/></svg><b id="streak-n">0</b></button>
  </div>

  <main class="stage"><div id="board" role="grid" aria-label="Игровое поле"></div>
    <div id="says" aria-live="polite"></div></main>

  <div id="kb"></div>
  <div id="playbar">
    <button class="btn" id="pb-result"><svg class="i" aria-hidden="true"><use href="#i-trophy"/></svg> <span>Итог</span></button>
    <button class="btn primary" id="pb-new"><svg class="i" aria-hidden="true"><use href="#i-refresh"/></svg> <span>Играть ещё</span></button>
    <button class="btn" id="pb-home"><svg class="i" aria-hidden="true"><use href="#i-home"/></svg> <span>На главную</span></button>
  </div>
  </div>
  <aside class="side" id="side" aria-label="Рейтинг и статистика">
    <section class="panel lb-panel"><h3><svg class="i" aria-hidden="true"><use href="#i-trophy"/></svg> Лучшие игроки</h3><div class="lb mini" id="side-lb"></div></section>
    <section class="panel"><h3><svg class="i" aria-hidden="true"><use href="#i-user"/></svg> <span id="side-title">Ваша статистика</span></h3><div id="side-me"></div></section>
    <section class="panel hint-panel"><h3><svg class="i" aria-hidden="true"><use href="#i-help"/></svg> Подсказка</h3>
      <div class="legend" id="side-legend"></div></section>
  </aside>
  <footer class="foot">
    <div class="foot-text" id="foot-text" hidden></div>
    <div class="foot-app" id="foot-app" hidden><button type="button" class="linkbtn" id="inst-foot"><svg class="i" aria-hidden="true"><use href="#i-dl"/></svg> Поставить игру на телефон</button></div>
    <div class="sign"><span>© 2026 Словоплёт</span><i></i><span>Разработка <a href="https://iluh.in" target="_blank" rel="noopener">@iluhin</a></span></div>
  </footer>
</div>

<!-- Вход -->
<div class="modal" id="m-auth" data-lock="1">
  <div class="shade"></div>
  <div class="sheet">
    <button class="close" id="a-close" aria-label="На главную"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
    <div class="hero-tiles" id="hero"></div>
    <h2 class="ctr" style="text-align:center" data-cfg="title">Словоплёт</h2>
    <p class="sub" style="text-align:center" data-cfg="tagline">Угадай слово за 5 попыток</p>
    <div id="auth-main" class="stack">
      <button class="btn primary block" id="a-show-login"><svg class="i"><use href="#i-user"/></svg> Войти или создать профиль</button>
      <button class="btn block" id="a-guest"><svg class="i"><use href="#i-play"/></svg> Играть как гость</button>
      <p class="hint" id="a-guest-hint">Профиль сохраняет статистику, серию побед и место в рейтинге.</p>
    </div>
    <form id="auth-form" class="stack" style="display:none" autocomplete="off">
      <div class="field"><input id="a-name" type="text" placeholder="Имя" maxlength="20" autocomplete="username" autocapitalize="off"></div>
      <div class="field"><input id="a-pass" type="password" placeholder="Пароль" autocomplete="current-password"><button type="button" class="eye" id="a-eye" aria-label="Показать пароль"><svg class="i" aria-hidden="true"><use href="#i-eye"/></svg></button></div>
      <div class="msg" id="a-msg"></div>
      <button class="btn primary block" type="submit" id="a-submit">Начать игру</button>
      <button class="linkbtn" type="button" id="a-back">Назад</button>
      <p class="hint" id="a-reg-hint">Нового имени ещё нет? Профиль создастся автоматически с этим паролем.</p>
    </form>
  </div>
</div>

<!-- Рейтинг -->
<div class="modal" id="m-lb"><div class="shade"></div><div class="sheet">
  <button class="close" data-close aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  <h2>Рейтинг</h2><p class="sub" id="lb-sub">Лучшие игроки</p>
  <p class="lb-live" id="lb-live" hidden><i class="on"></i><span>зелёный огонёк — игрок сейчас за игрой</span></p>
  <div class="lb" id="lb-list"></div>
  <div class="lb-guest" id="lb-guest" hidden></div>
</div></div>

<!-- Профиль -->
<div class="modal" id="m-user"><div class="shade"></div><div class="sheet">
  <button class="close" data-close aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  <h2 id="u-name">Профиль</h2><p class="sub" id="u-sub"></p>
  <div id="u-body"></div>
</div></div>

<!-- Как играть -->
<div class="modal" id="m-help"><div class="shade"></div><div class="sheet">
  <button class="close" data-close aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  <h2>Как играть</h2>
  <p class="sub">Угадайте слово из 5 букв. После каждой попытки буквы подсветятся.</p>
  <div class="demo" id="demo"></div>
  <div class="legend" id="legend"></div>
</div></div>

<!-- Тема -->
<div class="modal" id="m-theme"><div class="shade"></div><div class="sheet">
  <button class="close" data-close aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  <h2>Оформление</h2><p class="sub">Выберите настроение — оно запомнится на этом устройстве.</p>
  <div class="themes" id="themes"></div>
</div></div>

<!-- Итог -->
<div class="modal" id="m-res"><div class="shade"></div><div class="sheet">
  <button class="close" data-close aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  <div class="res-title"><h2 class="ctr" id="r-title"></h2><p class="sub" id="r-sub"></p></div>
  <div class="res-word" id="r-word"></div>
  <div class="def" id="r-def" hidden></div>
  <div class="res-badges" id="r-badges"></div>
  <p class="res-quip" id="r-quip" hidden></p>
  <div class="stack">
    <div class="row2">
      <button class="btn sm" id="r-share"><svg class="i" aria-hidden="true"><use href="#i-share"/></svg> Поделиться</button>
      <a class="btn sm" id="r-wiki" target="_blank" rel="noopener" style="text-decoration:none;color:inherit"><svg class="i" aria-hidden="true"><use href="#i-book"/></svg> <span id="r-wiki-t">Подробнее</span></a>
    </div>
    <button class="btn primary block" id="r-again"><svg class="i" aria-hidden="true"><use href="#i-refresh"/></svg> Играть ещё</button>
    <div class="row2">
      <button class="btn ghost sm" id="r-lb"><svg class="i" aria-hidden="true"><use href="#i-trophy"/></svg> Рейтинг</button>
      <button class="btn ghost sm" id="r-report" title="Пожаловаться на слово"><svg class="i" aria-hidden="true"><use href="#i-flag"/></svg> Пожаловаться</button>
    </div>
    <button class="btn ghost sm block" id="r-home"><svg class="i" aria-hidden="true"><use href="#i-home"/></svg> На главную</button>
  </div>
  <p class="next-in" id="r-next"></p>
</div></div>

<!-- Жалоба на слово -->
<div class="modal" id="m-report"><div class="shade"></div><div class="sheet">
  <button class="close" data-close aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  <h2>Жалоба на слово</h2><p class="sub" id="rp-sub">Что не так со словом?</p>
  <div class="reasons" id="rp-reasons">
    <button type="button" class="reason" data-r="nodict">Такого слова нет в словарях</button>
    <button type="button" class="reason" data-r="rare">Слишком редкое или малоизвестное</button>
    <button type="button" class="reason" data-r="meaning">Неверное или странное толкование</button>
    <button type="button" class="reason" data-r="proper">Имя собственное, сокращение, жаргон</button>
    <button type="button" class="reason" data-r="offensive">Неприемлемое слово</button>
    <button type="button" class="reason" data-r="other">Другое</button>
      </div>
  <div class="field"><textarea id="rp-text" maxlength="300" rows="3" placeholder="Комментарий (необязательно)"></textarea></div>
  <div class="msg" id="rp-msg"></div>
  <button class="btn primary block" id="rp-send"><svg class="i" aria-hidden="true"><use href="#i-flag"/></svg> Отправить жалобу</button>
</div></div>

<!-- Обновление приложения -->
<div class="modal" id="m-upd"><div class="shade"></div><div class="sheet">
  <button class="close" data-close aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  <h2 id="upd-title">Доступно обновление</h2>
  <p class="sub" id="upd-sub"></p>
  <div class="upd-notes" id="upd-notes"></div>
  <div class="upd-bar" id="upd-bar" hidden><i id="upd-bar-i"></i></div>
  <p class="hint" id="upd-msg"></p>
  <div class="stack">
    <button class="btn primary block" id="upd-go"><svg class="i" aria-hidden="true"><use href="#i-dl"/></svg> Обновить</button>
    <button class="btn block" id="upd-later">Позже</button>
  </div>
</div></div>

<!-- Приложение на телефон -->
<div class="modal" id="m-install"><div class="shade"></div><div class="sheet">
  <button class="close" data-close aria-label="Закрыть"><svg class="i" aria-hidden="true"><use href="#i-x"/></svg></button>
  <h2>Игра на телефоне</h2>
  <p class="sub" id="inst-sub">Та же игра, но с иконки и без браузера.</p>
  <div class="inst-plus">
    <div><svg class="i" aria-hidden="true"><use href="#i-play"/></svg><span>Запускается мгновенно, с иконки на экране</span></div>
    <div><svg class="i" aria-hidden="true"><use href="#i-clock"/></svg><span>Играется без интернета — режим «Случайное слово»</span></div>
    <div><svg class="i" aria-hidden="true"><use href="#i-refresh"/></svg><span>Слова и настройки обновляются с сайта сами</span></div>
  </div>
  <div class="inst-qr" id="inst-qr" hidden>
