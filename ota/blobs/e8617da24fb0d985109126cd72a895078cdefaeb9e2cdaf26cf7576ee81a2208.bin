/* Словоплёт — оформление игры. Темы задаются через [data-theme]. */
:root {
  --font-ui: 'Manrope', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --font-tile: 'Rubik', 'Manrope', system-ui, sans-serif;
  --r: 18px;
  --ease: cubic-bezier(.2, .8, .2, 1);
}

/* ---------- Темы ----------
   Три состояния буквы различаются и оттенком (тёплый / холодный / нейтральный), и яркостью,
   поэтому читаются и при дальтонизме. Контраст текста на плитках не ниже 4.5:1. */
[data-theme="aurora"] {
  --bg1: #0a0c1f; --bg2: #1b1147; --blob1: #6d4cff; --blob2: #14b8d6; --blob3: #ff4fa3;
  --panel: rgba(255,255,255,.07); --panel-b: rgba(255,255,255,.14); --sheet: #14163a;
  --text: #f4f5ff; --muted: #a9aeda;
  --tile-bg: rgba(255,255,255,.05); --tile-b: rgba(255,255,255,.18); --tile-bf: rgba(255,255,255,.6);
  --c-bg: #ffd43b; --c-t: #241a00; --p-bg: #4f9dff; --p-t: #00142e; --a-bg: #353a66; --a-t: #d2d6f7;
  --key: rgba(255,255,255,.13); --key-t: #f4f5ff;
  --accent: #7c5cff; --accent2: #22d3ee; --glow: rgba(124,92,255,.55); --danger: #ff6b8a; --ok: #34d399;
  --letter: rgba(255,255,255,.05); color-scheme: dark;
}
[data-theme="midnight"] {
  --bg1: #0e0e10; --bg2: #1c1c1f; --blob1: #26345f; --blob2: #163f3a; --blob3: #33264a;
  --panel: rgba(255,255,255,.06); --panel-b: rgba(255,255,255,.12); --sheet: #1f1f23;
  --text: #f5f5f7; --muted: #a1a1aa;
  --tile-bg: transparent; --tile-b: #45454b; --tile-bf: #9b9ba4;
  --c-bg: #ffd43b; --c-t: #241a00; --p-bg: #4f9dff; --p-t: #00142e; --a-bg: #3a3a40; --a-t: #d6d6db;
  --key: #3a3a40; --key-t: #ffffff;
  --accent: #4f8aff; --accent2: #20b2aa; --glow: rgba(79,138,255,.45); --danger: #ff6b6b; --ok: #3ddc97;
  --letter: rgba(255,255,255,.035); color-scheme: dark;
}
[data-theme="matcha"] {
  --bg1: #07130e; --bg2: #123226; --blob1: #2fbf71; --blob2: #c6f432; --blob3: #12877a;
  --panel: rgba(255,255,255,.06); --panel-b: rgba(255,255,255,.13); --sheet: #12261d;
  --text: #edfff5; --muted: #98c6ad;
  --tile-bg: rgba(255,255,255,.04); --tile-b: rgba(255,255,255,.18); --tile-bf: rgba(237,255,245,.62);
  --c-bg: #ffd43b; --c-t: #241a00; --p-bg: #5eb3ff; --p-t: #00182f; --a-bg: #2b4a3b; --a-t: #d3ecdf;
  --key: rgba(255,255,255,.11); --key-t: #edfff5;
  --accent: #2fbf71; --accent2: #c6f432; --glow: rgba(47,191,113,.5); --danger: #ff7a7a; --ok: #7dffb0;
  --letter: rgba(255,255,255,.04); color-scheme: dark;
}
[data-theme="sunset"] {
  --bg1: #ffe6d0; --bg2: #ffbfa8; --blob1: #ff7e5f; --blob2: #feb47b; --blob3: #ffd166;
  --panel: rgba(255,255,255,.6); --panel-b: rgba(255,255,255,.85); --sheet: #fff8f2;
  --text: #3e2119; --muted: #8a5a4c;
  --tile-bg: rgba(255,255,255,.6); --tile-b: #eaa48b; --tile-bf: #c4553a;
  --c-bg: #c2410c; --c-t: #ffffff; --p-bg: #4dabf7; --p-t: #06263f; --a-bg: #e3d3cc; --a-t: #5a3f37;
  --key: rgba(255,255,255,.85); --key-t: #5c3328;
  --accent: #e8590c; --accent2: #f59f00; --glow: rgba(232,89,12,.45); --danger: #c2255c; --ok: #0b7a53;
  --letter: rgba(120,50,30,.07); color-scheme: light;
}
[data-theme="candy"] {
  --bg1: #f6f3ff; --bg2: #dfe8ff; --blob1: #b79cff; --blob2: #8ab4ff; --blob3: #ffc6e6;
  --panel: rgba(255,255,255,.7); --panel-b: rgba(255,255,255,.95); --sheet: #ffffff;
  --text: #241f4a; --muted: #6a6592;
  --tile-bg: rgba(255,255,255,.8); --tile-b: #cbc4ee; --tile-bf: #6d58d6;
  --c-bg: #f59f00; --c-t: #2b1a00; --p-bg: #1971c2; --p-t: #ffffff; --a-bg: #dfe2f1; --a-t: #4a5074;
  --key: #ffffff; --key-t: #3d3480;
  --accent: #6d4cff; --accent2: #1c9ad6; --glow: rgba(109,76,255,.4); --danger: #d6336c; --ok: #12805c;
  --letter: rgba(90,70,200,.07); color-scheme: light;
}
[data-theme="contrast"] {
  --bg1: #000000; --bg2: #0d0d0d; --blob1: #222222; --blob2: #1a1a1a; --blob3: #222222;
  --panel: rgba(255,255,255,.08); --panel-b: rgba(255,255,255,.35); --sheet: #101010;
  --text: #ffffff; --muted: #c4c4c4;
  --tile-bg: transparent; --tile-b: #8a8a8a; --tile-bf: #ffffff;
  --c-bg: #ffe14d; --c-t: #000000; --p-bg: #2e8bff; --p-t: #000000; --a-bg: #2b2b2b; --a-t: #f0f0f0;
  --key: #2b2b2b; --key-t: #ffffff;
  --accent: #3db8ff; --accent2: #ffd60a; --glow: rgba(61,184,255,.4); --danger: #ff6b6b; --ok: #4ade80;
  --letter: rgba(255,255,255,.03); color-scheme: dark;
}

/* ---------- Основа ---------- */
* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; margin: 0; }
body {
  font-family: var(--font-ui); color: var(--text); background: var(--bg1);
  overflow: hidden; overscroll-behavior: none; -webkit-font-smoothing: antialiased;
  user-select: none; -webkit-user-select: none;
}
[hidden] { display: none !important; }
button { font: inherit; color: inherit; cursor: pointer; border: 0; background: none; padding: 0; }
input { font: inherit; }
svg.i { width: 1.25em; height: 1.25em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex: none; }

/* ---------- Фон ---------- */
.bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: linear-gradient(160deg, var(--bg1), var(--bg2)); }
.bg .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .5; will-change: transform; }
.bg .b1 { width: 52vmax; height: 52vmax; left: -14vmax; top: -16vmax; background: var(--blob1); animation: drift1 24s ease-in-out infinite alternate; }
.bg .b2 { width: 44vmax; height: 44vmax; right: -12vmax; top: 20vh; background: var(--blob2); animation: drift2 28s ease-in-out infinite alternate; opacity: .38; }
.bg .b3 { width: 40vmax; height: 40vmax; left: 10vw; bottom: -20vmax; background: var(--blob3); animation: drift3 32s ease-in-out infinite alternate; opacity: .34; }
body.cvd .tile[data-s="p"]::before, body.cvd .key[data-s="p"]::before { content: ''; position: absolute; top: 7%; right: 7%; width: 18%; height: 18%; max-width: 10px; max-height: 10px; border-radius: 50%; background: currentColor; opacity: .75; }
body.cvd .key { position: relative; }
body.cvd .tile[data-s="c"]::after { content: ''; position: absolute; left: 22%; right: 22%; bottom: 9%; height: 3px; border-radius: 3px; background: currentColor; opacity: .65; }
.bg .grain { position: absolute; inset: 0; background-image: radial-gradient(var(--letter) 1px, transparent 1px); background-size: 26px 26px; opacity: .8; }
.bg .fl { position: absolute; font: 800 var(--s, 60px) var(--font-tile); color: var(--letter); animation: floatUp var(--d, 30s) linear infinite; animation-delay: var(--dl, 0s); left: var(--x, 50%); bottom: -120px; }
@keyframes drift1 { to { transform: translate(14vmax, 10vmax) scale(1.15); } }
@keyframes drift2 { to { transform: translate(-12vmax, -8vmax) scale(.9); } }
@keyframes drift3 { to { transform: translate(10vmax, -12vmax) scale(1.2); } }
@keyframes floatUp { from { transform: translateY(0) rotate(-8deg); } to { transform: translateY(-120vh) rotate(14deg); } }

/* ---------- Каркас ---------- */
#app {
  /* width: 100% — каркас обязан быть ровно шириной окна. Без него браузер
     подбирал ширину по содержимому: на узком телефоне (360–384 точки) шапка
     не умещалась, каркас раздувался шире экрана, и крайняя кнопка с плашкой
     уезжали за правый край. На широком экране ширину по-прежнему ограничивает
     max-width, а margin: 0 auto держит каркас по центру. */
  position: relative; z-index: 1; height: 100%; height: 100dvh; width: 100%; max-width: 520px; margin: 0 auto; min-width: 0;
  display: flex; flex-direction: column; padding: max(10px, env(safe-area-inset-top)) 14px max(10px, env(safe-area-inset-bottom));
  gap: 8px;
}
.top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
.logo {
  width: 42px; height: 42px; border-radius: 14px; display: grid; place-items: center; flex: none;
  font: 800 24px var(--font-tile); color: #fff; background: linear-gradient(135deg, var(--accent), var(--accent2));
  box-shadow: 0 8px 22px -6px var(--glow); transform: rotate(-6deg); animation: logoWob 6s ease-in-out infinite;
}
@keyframes logoWob { 50% { transform: rotate(5deg) scale(1.05); } }
/* min-width: 0 — иначе обёртка названия не даёт шапке сжаться: заголовок
   написан в одну строку, и его полная ширина становится минимальной шириной
   всего каркаса. На узком телефоне из-за этого крайняя кнопка и плашка
   уезжали за правый край экрана. */
.brand > div { min-width: 0; }
.brand h1 { margin: 0; font: 800 20px/1.1 var(--font-tile); letter-spacing: .2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.brand p { margin: 2px 0 0; font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.actions { display: flex; gap: 6px; flex: none; }
.ibtn {
  width: 40px; height: 40px; border-radius: 13px; display: grid; place-items: center;
  background: var(--panel); border: 1px solid var(--panel-b); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  transition: transform .18s var(--ease), background .2s, box-shadow .2s;
}
.ibtn:hover { transform: translateY(-2px); box-shadow: 0 8px 18px -8px var(--glow); }
.ibtn:active { transform: scale(.92); }
.ibtn.off { opacity: .55; }
.ibtn[hidden] { display: none; }

/* HUD */
.hud { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; }
.chip {
  display: inline-flex; align-items: center; gap: 7px; height: 36px; padding: 0 14px; border-radius: 999px;
  background: var(--panel); border: 1px solid var(--panel-b); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  font-weight: 700; font-size: 14px; white-space: nowrap;
}
.chip.clickable { cursor: pointer; transition: transform .15s; }
.chip.clickable:active { transform: scale(.95); }
.chip .i { color: var(--accent2); }
#timer { font: 800 17px var(--font-tile); font-variant-numeric: tabular-nums; letter-spacing: .5px; min-width: 88px; justify-content: center; }
#timer.run { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; border-color: transparent; box-shadow: 0 8px 22px -8px var(--glow); }
#timer.run .i { color: #fff; }
#timer.run .i { animation: tick 1s steps(2) infinite; }
@keyframes tick { 50% { transform: rotate(12deg); } }
.pips { display: inline-flex; gap: 4px; }
.pips i { width: 8px; height: 8px; border-radius: 50%; background: var(--tile-b); transition: background .3s, transform .3s var(--ease); }
.pips i.used { background: var(--accent2); transform: scale(1.2); }
.streak { color: #ff9f43; }

/* Поле */
.stage { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
/* --tile-max — потолок для плитки; точный размер подбирает fitBoard() по
   свободному месту, иначе на вытянутых экранах поле наезжало на клавиатуру. */
#board { display: grid; gap: 8px; --tile-max: 66px; --tile: min(var(--tile-max), calc((100vw - 28px - 32px) / 5), calc((100dvh - 330px) / var(--rows, 5) - 8px)); }
.row { display: grid; grid-template-columns: repeat(5, var(--tile)); gap: 8px; transition: opacity .4s; }
.row.future { opacity: .5; }
.row.shake { animation: shake .45s; }
@keyframes shake { 15%, 55% { transform: translateX(-9px); } 35%, 75% { transform: translateX(9px); } 95% { transform: translateX(-3px); } }
.tile {
  height: var(--tile); border-radius: calc(var(--tile) * .22); display: grid; place-items: center; position: relative;
  font: 800 calc(var(--tile) * .52) var(--font-tile); text-transform: uppercase; color: var(--text);
  background: var(--tile-bg); border: 2px solid var(--tile-b); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  transition: border-color .15s, box-shadow .2s;
}
.tile.cur { border-color: var(--accent2); box-shadow: 0 0 0 4px rgba(127,127,127,.12), 0 0 20px -2px var(--glow); }
.tile.cur:not(.f)::after { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent2); box-shadow: 0 0 10px var(--accent2); animation: blink 1.2s ease-in-out infinite; }
@keyframes blink { 50% { opacity: .2; transform: scale(.6); } }
.tile.f { border-color: var(--tile-bf); }
.tile.pop { animation: pop .16s var(--ease); }
@keyframes pop { 50% { transform: scale(1.14); } }
.tile.flip { animation: flip var(--flip, .56s) ease-in-out; }
@keyframes flip { 0% { transform: rotateX(0); } 50% { transform: rotateX(90deg); } 100% { transform: rotateX(0); } }
.tile[data-s] { border-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
.tile[data-s="c"] { background: var(--c-bg); color: var(--c-t); box-shadow: 0 8px 20px -8px var(--c-bg); }
.tile[data-s="p"] { background: var(--p-bg); color: var(--p-t); box-shadow: 0 8px 20px -10px var(--p-bg); }
.tile[data-s="a"] { background: var(--a-bg); color: var(--a-t); }
.tile.bounce { animation: bounce .9s var(--ease); }
@keyframes bounce { 0%, 20% { transform: translateY(0); } 40% { transform: translateY(-22px); } 50% { transform: translateY(4px); } 60% { transform: translateY(-10px); } 80% { transform: translateY(2px); } 100% { transform: translateY(0); } }
.tile.drop { animation: drop .5s var(--ease) both; }
@keyframes drop { from { opacity: 0; transform: translateY(-14px) scale(.85); } }

/* Клавиатура */
#kb { display: flex; flex-direction: column; gap: 7px; padding-bottom: 2px; }
.kr { display: flex; gap: 5px; justify-content: center; }
.key {
  flex: 1 1 0; min-width: 0; height: 50px; border-radius: 11px; display: grid; place-items: center;
  font: 700 17px var(--font-tile); background: var(--key); color: var(--key-t); border: 1px solid var(--panel-b);
  transition: transform .1s, background .35s, color .35s, box-shadow .2s; touch-action: manipulation;
}
.key:hover { box-shadow: 0 6px 14px -8px var(--glow); }
.key:active, .key.press { transform: scale(.88); }
.key.wide { flex: 1.65 1 0; font-size: 12px; letter-spacing: .4px; }
.key[data-s="c"] { background: var(--c-bg); color: var(--c-t); border-color: transparent; }
.key[data-s="p"] { background: var(--p-bg); color: var(--p-t); border-color: transparent; }
.key[data-s="a"] { background: transparent; color: var(--muted); border: 1px dashed var(--panel-b); opacity: .55; box-shadow: none; }
.key.enter { background: linear-gradient(135deg, var(--accent), var(--accent2)); color: #fff; border-color: transparent; }

/* Три действия в ряд: значок над подписью, иначе на 360 точках подписи
   наезжают друг на друга. «Играть ещё» остаётся главной и синей — она и
   затягивает на следующий круг. */
/* Колонки задаются потоком, а не числом: спрятанная кнопка не оставляет
   пустого места, две оставшиеся честно делят ширину. */
#playbar { display: none; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 8px; padding: 4px 0 6px; }
.over #playbar { display: grid; }
#playbar .btn { min-width: 0; width: 100%; height: 62px; padding: 8px 4px; border-radius: 16px; flex-direction: column; gap: 5px; font-size: 12px; line-height: 1.15; }
#playbar .btn .i { width: 20px; height: 20px; }
#playbar .btn span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.over #kb { display: none; }
.over #playbar { animation: rise .5s var(--ease); }
@keyframes rise { from { opacity: 0; transform: translateY(20px); } }

/* Кнопки */
.btn {
  height: 52px; padding: 0 22px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; gap: 9px;
  font-weight: 800; font-size: 16px; letter-spacing: .2px; transition: transform .15s var(--ease), box-shadow .2s, filter .2s;
  background: var(--panel); border: 1px solid var(--panel-b); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
}
.btn:active { transform: scale(.96); }
.btn.primary { color: #fff; border-color: transparent; background: linear-gradient(135deg, var(--accent), var(--accent2)); box-shadow: 0 12px 28px -10px var(--glow); }
.btn.primary:hover { filter: brightness(1.08); transform: translateY(-2px); }
.btn.ghost { background: transparent; }
.btn.sm { height: 40px; font-size: 14px; padding: 0 16px; border-radius: 12px; }
.btn[disabled] { opacity: .5; pointer-events: none; }
.btn.block { width: 100%; }

/* Футер */
.foot { text-align: center; font-size: 11px; color: var(--muted); min-height: 0; }
.foot-text { margin-bottom: 3px; }
.sign { display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 11px; font-weight: 600; letter-spacing: .4px; color: var(--muted); opacity: .62; transition: opacity .25s; }
.sign:hover { opacity: 1; }
.sign i { width: 3px; height: 3px; border-radius: 50%; background: var(--accent2); opacity: .8; }
.sign a { color: inherit; text-decoration: none; background: linear-gradient(90deg, var(--accent), var(--accent2)) left bottom / 0 1px no-repeat; transition: background-size .3s var(--ease), color .2s; padding-bottom: 1px; }
.sign a:hover { color: var(--text); background-size: 100% 1px; }
@media (max-height: 640px) { .sign { font-size: 10px; } }

/* ---------- Модалки ---------- */
.modal { position: fixed; inset: 0; z-index: 20; display: none; align-items: flex-end; justify-content: center; padding: 0; }
.modal.open { display: flex; }
.modal .shade { position: absolute; inset: 0; background: rgba(5,6,20,.55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); animation: fade .25s; }
.sheet {
  position: relative; width: 100%; max-width: 480px; max-height: 92dvh; overflow: auto; background: var(--sheet); color: var(--text);
  border: 1px solid var(--panel-b); border-radius: 28px 28px 0 0; padding: 22px 20px calc(22px + env(safe-area-inset-bottom));
  box-shadow: 0 -20px 60px -20px rgba(0,0,0,.5); animation: sheetIn .45s var(--ease); user-select: text; -webkit-user-select: text;
}
@media (min-width: 560px) {
  .modal { align-items: center; padding: 20px; }
  .sheet { border-radius: 28px; animation: sheetPop .45s var(--ease); }
}
@keyframes sheetIn { from { transform: translateY(60px); opacity: 0; } }
@keyframes sheetPop { from { transform: scale(.88) translateY(20px); opacity: 0; } }
@keyframes fade { from { opacity: 0; } }
.sheet h2 { margin: 0 0 4px; font: 800 24px var(--font-tile); }
/* Длинный заголовок не должен подлезать под крестик в углу. */
.sheet:has(> .close) h2 { padding-right: 44px; }
/* Но заголовок по центру поджимать с одной стороны нельзя: середина уедет
   влево ровно на половину отступа. Такие поджимаем с обеих сторон — крестик
   по-прежнему свободен, а центр остаётся центром. */
.sheet:has(> .close) h2.ctr { padding-left: 44px; padding-right: 44px; }
.sheet .sub { margin: 0 0 16px; color: var(--muted); font-size: 14px; line-height: 1.45; }
.sheet .close { position: absolute; right: 14px; top: 14px; width: 36px; height: 36px; border-radius: 12px; display: grid; place-items: center; background: var(--panel); border: 1px solid var(--panel-b); }
.sheet .close:active { transform: scale(.9); }
.divider { height: 1px; background: var(--panel-b); margin: 16px 0; }

/* Вход */
.hero-tiles { display: flex; gap: 7px; justify-content: center; margin: 4px 0 18px; }
.hero-tiles span {
  width: 46px; height: 54px; border-radius: 14px; display: grid; place-items: center; font: 800 26px var(--font-tile); color: var(--p-t);
  background: var(--p-bg); animation: heroFlip 5s ease-in-out infinite; animation-delay: calc(var(--i) * .18s);
}
.hero-tiles span.c { background: var(--c-bg); color: var(--c-t); }
.hero-tiles span.a { background: var(--a-bg); color: var(--a-t); }
@keyframes heroFlip { 0%, 70%, 100% { transform: rotateX(0); } 80% { transform: rotateX(360deg); } }
.field { position: relative; margin-bottom: 10px; }
.field input {
  width: 100%; height: 54px; border-radius: 16px; padding: 0 16px; border: 1.5px solid var(--panel-b); background: var(--panel);
  color: var(--text); font-size: 16px; font-weight: 600; outline: none; transition: border-color .2s, box-shadow .2s; user-select: text; -webkit-user-select: text;
}
.field input::placeholder { color: var(--muted); font-weight: 500; }
.field input:focus { border-color: var(--accent2); box-shadow: 0 0 0 4px rgba(127,127,127,.12); }
.field .eye { position: absolute; right: 8px; top: 7px; width: 40px; height: 40px; display: grid; place-items: center; color: var(--muted); }
.msg { min-height: 20px; margin: 2px 2px 10px; font-size: 13px; font-weight: 600; color: var(--danger); }
.stack { display: flex; flex-direction: column; gap: 10px; }
.hint { font-size: 13.5px; color: var(--muted); text-align: center; margin: 8px 0 0; line-height: 1.5; }
.linkbtn { color: var(--accent2); font-weight: 700; font-size: 14px; padding: 8px; }

/* Статистика */
.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 14px 0; }
.stat { text-align: center; padding: 12px 4px; border-radius: 16px; background: var(--panel); border: 1px solid var(--panel-b); }
.stat b { display: block; font: 800 22px var(--font-tile); }
.stat span { font-size: 11px; color: var(--muted); font-weight: 600; }
.dist { display: flex; flex-direction: column; gap: 6px; }
.dist .dr { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; }
.dist .dr .bar { height: 22px; min-width: 24px; border-radius: 8px; padding: 0 8px; display: flex; align-items: center; justify-content: flex-end; background: var(--a-bg); color: var(--a-t); font-size: 12px; transition: width .8s var(--ease); width: 24px; }
.dist .dr .bar.hit { background: linear-gradient(90deg, var(--accent), var(--accent2)); color: #fff; }

/* Рейтинг */
.lb { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
.lbr { display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 16px; background: var(--panel); border: 1px solid var(--panel-b); animation: rowIn .5s var(--ease) both; animation-delay: calc(var(--i) * 55ms); }
@keyframes rowIn { from { opacity: 0; transform: translateX(-16px); } }
.lbr.me { border-color: var(--accent2); box-shadow: 0 0 0 3px rgba(127,127,127,.12), 0 8px 22px -12px var(--glow); }
.lbr .pos { width: 34px; height: 34px; border-radius: 11px; display: grid; place-items: center; font: 800 15px var(--font-tile); background: var(--a-bg); color: var(--a-t); }
.lbr:nth-child(1) .pos { background: linear-gradient(135deg, #ffd34e, #ff9f1c); color: #3a2500; }
.lbr:nth-child(2) .pos { background: linear-gradient(135deg, #e9edf5, #aab4c8); color: #26304a; }
.lbr:nth-child(3) .pos { background: linear-gradient(135deg, #f0a56a, #b8693a); color: #2e1707; }
.lbr .nm { font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lbr .nm small { display: block; font-weight: 600; font-size: 11.5px; color: var(--muted); margin-top: 1px; }
.lbr .val { text-align: right; font: 800 17px var(--font-tile); }
.lbr .val small { display: block; font: 600 11px var(--font-ui); color: var(--muted); }
.empty { text-align: center; color: var(--muted); padding: 26px 0; }

/* Справка */
.demo { display: flex; gap: 6px; margin: 8px 0; }
.demo .tile { --tile: 44px; width: 44px; }
.legend { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; font-size: 14px; }
.legend div { display: flex; align-items: center; gap: 10px; }
.legend .dot { width: 22px; height: 22px; border-radius: 7px; flex: none; }
.legend ul { margin: 0; padding-left: 18px; color: var(--muted); line-height: 1.6; }

/* Тема */
.themes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 8px; }
.theme-card { border-radius: 18px; padding: 10px; border: 2px solid transparent; background: linear-gradient(160deg, var(--bg1), var(--bg2)); color: var(--text); text-align: left; transition: transform .2s var(--ease), border-color .2s; }
.theme-card:hover { transform: translateY(-3px); }
.theme-card.active { border-color: var(--accent2); box-shadow: 0 10px 26px -12px var(--glow); }
.theme-card .mini { display: flex; gap: 4px; margin-bottom: 8px; }
.theme-card .mini i { flex: 1; height: 22px; border-radius: 6px; background: var(--tile-bg); border: 1.5px solid var(--tile-b); }
.theme-card .mini i.c { background: var(--c-bg); border-color: transparent; }
.theme-card .mini i.p { background: var(--p-bg); border-color: transparent; }
.theme-card .mini i.a { background: var(--a-bg); border-color: transparent; }
.theme-card b { font-size: 13px; }

/* Итог */
.res-word { display: flex; gap: 6px; justify-content: center; margin: 10px 0 14px; }
.res-word .tile { --tile: 48px; width: 48px; animation: drop .5s var(--ease) both; animation-delay: calc(var(--i) * 80ms); }
.res-title { text-align: center; }
.res-title h2 { font-size: 28px; }
.res-badges { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 14px; }
.badge { padding: 7px 14px; border-radius: 999px; background: var(--panel); border: 1px solid var(--panel-b); font-weight: 700; font-size: 13.5px; display: inline-flex; gap: 6px; align-items: center; }
.badge.rec { background: linear-gradient(135deg, #ffd34e, #ff9f1c); color: #3a2500; border-color: transparent; animation: pulse 1.6s ease-in-out infinite; }
@keyframes pulse { 50% { transform: scale(1.06); } }
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.next-in { text-align: center; color: var(--muted); font-size: 13px; margin: 8px 0 0; }

/* Тосты */
#toasts { position: fixed; left: 0; right: 0; top: max(70px, calc(env(safe-area-inset-top) + 60px)); z-index: 40; display: flex; flex-direction: column; align-items: center; gap: 8px; pointer-events: none; }
.toast { padding: 11px 18px; border-radius: 14px; font-weight: 700; font-size: 14.5px; background: var(--text); color: var(--bg1); box-shadow: 0 14px 34px -10px rgba(0,0,0,.5); animation: toastIn .35s var(--ease); max-width: 90vw; text-align: center; }
.toast.err { background: var(--danger); color: #fff; }
.toast.ok { background: var(--ok); color: #05301f; }
.toast.out { opacity: 0; transform: translateY(-10px) scale(.95); transition: .3s; }
@keyframes toastIn { from { opacity: 0; transform: translateY(-14px) scale(.9); } }

#confetti { position: fixed; inset: 0; z-index: 50; pointer-events: none; }

/* Загрузка: пять плиток «проверяются» как попытка в игре, снизу — прогресс */
#boot { position: fixed; inset: 0; z-index: 60; display: grid; place-items: center; overflow: hidden; background: linear-gradient(160deg, var(--bg1), var(--bg2)); transition: opacity .55s; }
#boot.done { opacity: 0; pointer-events: none; }
#boot::before { content: ''; position: absolute; left: 50%; top: 42%; width: 90vmin; height: 90vmin; border-radius: 50%; transform: translate(-50%, -50%); background: radial-gradient(circle, var(--glow), transparent 65%); opacity: .55; animation: btGlow 3.4s ease-in-out infinite; }
@keyframes btGlow { 50% { transform: translate(-50%, -50%) scale(1.18); opacity: .85; } }
.bt-wrap { position: relative; display: flex; flex-direction: column; align-items: center; gap: 22px; padding: 0 24px; transition: opacity .5s, transform .55s var(--ease); }
#boot.done .bt-wrap { opacity: 0; transform: scale(1.07); }
.bt-logo { width: 64px; height: 64px; font-size: 36px; border-radius: 20px; }
.bt-row { display: flex; gap: clamp(6px, 2vw, 10px); perspective: 700px; }
.bt {
  --s-bg: var(--a-bg); --s-t: var(--a-t);
  width: clamp(46px, 13vw, 64px); height: clamp(54px, 15.5vw, 74px); border-radius: 16px; display: grid; place-items: center;
  font: 800 clamp(26px, 8vw, 38px) var(--font-tile); color: var(--text); background: var(--tile-bg); border: 2px solid var(--tile-b);
  animation: btFlip 3.4s ease-in-out infinite; animation-delay: calc(var(--i) * .17s);
}
.bt[data-s="c"] { --s-bg: var(--c-bg); --s-t: var(--c-t); }
.bt[data-s="p"] { --s-bg: var(--p-bg); --s-t: var(--p-t); }
.bt[data-s="a"] { --s-bg: var(--a-bg); --s-t: var(--a-t); }
@keyframes btFlip {
  0%, 12%   { transform: rotateX(0); background: var(--tile-bg); border-color: var(--tile-b); color: var(--text); box-shadow: none; }
  20%       { transform: rotateX(90deg); background: var(--tile-bg); border-color: var(--tile-b); color: var(--text); box-shadow: none; }
  20.5%     { transform: rotateX(90deg); background: var(--s-bg); border-color: transparent; color: var(--s-t); box-shadow: none; }
  29%, 58%  { transform: rotateX(0); background: var(--s-bg); border-color: transparent; color: var(--s-t); box-shadow: 0 12px 26px -10px var(--s-bg); }
  64%       { transform: translateY(-16px); background: var(--s-bg); border-color: transparent; color: var(--s-t); box-shadow: 0 22px 26px -14px var(--s-bg); }
  70%, 84%  { transform: translateY(0); background: var(--s-bg); border-color: transparent; color: var(--s-t); box-shadow: 0 12px 26px -10px var(--s-bg); }
  90%       { transform: rotateX(90deg); background: var(--s-bg); border-color: transparent; color: var(--s-t); box-shadow: none; }
  90.5%     { transform: rotateX(90deg); background: var(--tile-bg); border-color: var(--tile-b); color: var(--text); box-shadow: none; }
  97%, 100% { transform: rotateX(0); background: var(--tile-bg); border-color: var(--tile-b); color: var(--text); box-shadow: none; }
}
.bt-msg { min-height: 20px; font: 700 14px var(--font-ui); letter-spacing: .3px; color: var(--muted); text-align: center; }
.bt-bar { width: min(240px, 60vw); height: 6px; border-radius: 99px; background: var(--panel-b); overflow: hidden; }
.bt-bar i { display: block; height: 100%; width: 8%; border-radius: inherit; position: relative; overflow: hidden; background: linear-gradient(90deg, var(--accent), var(--accent2)); transition: width .55s var(--ease); }
.bt-bar i::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent); transform: translateX(-100%); animation: btShine 1.3s linear infinite; }
@keyframes btShine { to { transform: translateX(100%); } }
.bt-fail { color: var(--text); font: 600 16px/1.5 var(--font-ui); text-align: center; max-width: 320px; }
.bt-fail .btn { margin-top: 14px; }
body.calm #boot::before, body.calm .bt-logo { animation: none; }
body.calm .bt { animation: none; background: var(--s-bg); color: var(--s-t); border-color: transparent; }
@media (prefers-reduced-motion: reduce) {
  #boot::before, .bt-logo, .bt-bar i::after { animation: none !important; }
  .bt { animation: none !important; background: var(--s-bg); color: var(--s-t); border-color: transparent; }
}

/* Полноэкранный режим / низкие экраны */
@media (max-height: 640px) { .brand p, .hud .pips { display: none; } .key { height: 44px; } #kb { gap: 5px; } }
@media (max-width: 440px) {
  .brand p { display: none; } .brand { gap: 8px; } .logo { width: 38px; height: 38px; font-size: 21px; border-radius: 12px; }
  .actions { gap: 4px; } .ibtn { width: 36px; height: 36px; border-radius: 12px; }
}
@media (max-width: 360px) { .key { font-size: 15px; } .kr { gap: 4px; } .brand h1 { font-size: 17px; } .ibtn { width: 36px; height: 36px; } }

/* Меньше анимаций */
body.calm .bg .blob, body.calm .bg .fl, body.calm .logo, body.calm .hero-tiles span { animation: none; }
body.calm .tile.cur::after { animation: none; }
@media (prefers-reduced-motion: reduce) {
  .bg .blob, .bg .fl, .logo, .hero-tiles span, .tile.cur::after, .badge.rec { animation: none !important; }
}

/* ---------- Десктоп ---------- */
.play { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 8px; }
.side { display: none; }
.panel { background: var(--panel); border: 1px solid var(--panel-b); border-radius: 24px; padding: 20px; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
.panel h3 { margin: 0 0 14px; font: 800 17px var(--font-tile); display: flex; align-items: center; gap: 9px; }
.panel h3 .i { color: var(--accent2); }
.lb.mini { margin-top: 0; gap: 6px; }
.lb.mini .lbr { padding: 8px 10px; border-radius: 14px; }
.panel .stats { grid-template-columns: repeat(3, 1fr); margin: 0; }
.panel .legend { margin-top: 0; }

@media (min-width: 700px) and (min-height: 600px) {
  #app { max-width: 760px; padding-top: 18px; gap: 12px; }
  .logo { width: 52px; height: 52px; font-size: 29px; border-radius: 16px; }
  .brand h1 { font-size: 26px; } .brand p { font-size: 14px; }
  .ibtn { width: 48px; height: 48px; border-radius: 15px; } .ibtn .i { width: 22px; height: 22px; }
  .chip { height: 44px; font-size: 16px; padding: 0 18px; } #timer { font-size: 22px; min-width: 112px; }
  #board { gap: 10px; --tile-max: 96px; --tile: min(var(--tile-max), calc((100dvh - 440px) / var(--rows, 5) - 10px)); }
  .row { gap: 10px; }
  #kb { max-width: 700px; width: 100%; margin: 0 auto; gap: 9px; }
  .kr { gap: 7px; } .key { height: 62px; font-size: 22px; border-radius: 14px; } .key.wide { font-size: 14px; }
  .btn { height: 58px; font-size: 18px; }
  #playbar { max-width: 700px; width: 100%; margin: 0 auto; }
  .sheet { max-width: 540px; padding: 30px 30px 30px; } .sheet h2 { font-size: 28px; }
  .res-word .tile { --tile: 60px; width: 60px; } .demo .tile { --tile: 54px; width: 54px; }
  .toast { font-size: 16px; padding: 13px 22px; }
}
@media (min-width: 1000px) and (min-height: 600px) {
  #app { max-width: 1320px; padding: 24px 48px 18px; display: grid; grid-template-columns: minmax(0, 1fr) 380px; grid-template-rows: auto minmax(0, 1fr) auto; column-gap: 56px; row-gap: 12px; }
  .top { grid-column: 1 / -1; } .play { grid-column: 1; grid-row: 2; gap: 12px; }
  .foot { grid-column: 1 / -1; font-size: 12px; }
  /* Длинный рейтинг прокручивается внутри своей таблицы: профиль и подсказка
     остаются на месте, вся панель не едет. */
  .side { display: flex; flex-direction: column; gap: 16px; grid-column: 2; grid-row: 2; min-height: 0; overflow-y: auto; padding: 4px 2px 8px; scrollbar-width: none; }
  .side::-webkit-scrollbar { display: none; }
  .side > .panel { flex: 0 0 auto; }
  .side > .lb-panel { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 104px; }
  .lb-panel .lb { overflow-y: auto; min-height: 0; padding-right: 4px; margin-right: -4px; scrollbar-width: thin; scrollbar-color: var(--panel-b) transparent; }
  .lb-panel .lb::-webkit-scrollbar { width: 6px; }
  .lb-panel .lb::-webkit-scrollbar-thumb { background: var(--panel-b); border-radius: 99px; }
  /* На невысоком экране подсказку в панели прячем: она целиком есть в окне
     «Как играть», а рейтингу и профилю нужно место. */
  @media (max-height: 780px) { .side > .hint-panel { display: none; } }
  .brand p { display: block; }
  #b-lb, #b-user { display: none; }
  .logo { width: 58px; height: 58px; font-size: 32px; }
  .brand h1 { font-size: 30px; }
  #board { gap: 12px; --tile-max: 104px; --tile: min(var(--tile-max), calc((100dvh - 430px) / var(--rows, 5) - 10px)); }
  .row { gap: 12px; }
  #kb { max-width: 780px; } #playbar { max-width: 780px; }
  .key { height: 66px; font-size: 24px; }
  .tile.cur { box-shadow: 0 0 0 5px rgba(127,127,127,.12), 0 0 28px -2px var(--glow); }
}

/* Толкование */
.def { margin: 0 0 14px; padding: 14px 16px; border-radius: 16px; background: var(--panel); border: 1px solid var(--panel-b); text-align: left; animation: rise .4s var(--ease); }
.def-h { font: 800 12px var(--font-ui); letter-spacing: .6px; text-transform: uppercase; color: var(--accent2); margin-bottom: 7px; }
.def p, .def li { margin: 0; font-size: 15px; line-height: 1.5; }
.def ol { margin: 0; padding-left: 20px; display: grid; gap: 4px; }
.def-src { margin-top: 8px; font-size: 11.5px; color: var(--muted); }
.def-none { color: var(--muted); font-size: 14px !important; }
.shim { height: 12px; border-radius: 6px; margin: 6px 0; background: linear-gradient(90deg, var(--panel-b), var(--tile-b), var(--panel-b)); background-size: 200% 100%; animation: shim 1.2s linear infinite; }
.shim.s2 { width: 70%; }
@keyframes shim { to { background-position: -200% 0; } }

/* Жалоба на слово */
.reasons { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
.reason { display: flex; align-items: center; gap: 12px; text-align: left; padding: 12px 14px; border-radius: 14px; background: var(--panel); border: 1.5px solid var(--panel-b); font-weight: 700; font-size: 14.5px; transition: border-color .2s, box-shadow .2s, transform .15s; }
.reason::before { content: ''; flex: none; width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--tile-bf); transition: .2s; }
.reason:active { transform: scale(.98); }
.reason.on { border-color: var(--accent2); box-shadow: 0 0 0 3px rgba(127,127,127,.12); }
.reason.on::before { border-color: var(--accent2); background: radial-gradient(circle, var(--accent2) 45%, transparent 50%); }
.field textarea {
  display: block; width: 100%; border-radius: 16px; padding: 12px 16px; border: 1.5px solid var(--panel-b); background: var(--panel);
  color: var(--text); font: 600 15px/1.4 var(--font-ui); outline: none; resize: none; transition: border-color .2s, box-shadow .2s; user-select: text; -webkit-user-select: text;
}
.field textarea::placeholder { color: var(--muted); font-weight: 500; }
.field textarea:focus { border-color: var(--accent2); box-shadow: 0 0 0 4px rgba(127,127,127,.12); }

/* ---------- Автономный режим ---------- */
.offbar {
  display: flex; align-items: center; justify-content: center; gap: 9px;
  width: 100%; margin: 0 0 12px; padding: 10px 14px;
  border: 1px solid var(--panel-b); border-radius: 14px;
  background: var(--panel); color: var(--text);
  font: 800 13.5px/1.2 var(--font-ui); letter-spacing: .2px;
  cursor: pointer; backdrop-filter: blur(10px); transition: transform .15s var(--ease);
}
.offbar:active { transform: scale(.99); }
.offbar .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--danger); box-shadow: 0 0 0 4px rgba(255, 107, 138, .18); }
.offbar.back .dot { background: var(--ok); box-shadow: 0 0 0 4px rgba(52, 211, 153, .2); }
.rules { margin: 12px 0 0; padding-left: 20px; color: var(--muted); font-size: 14px; line-height: 1.55; }
.rules li { margin: 7px 0; }
.cached-note { margin-top: 10px; color: var(--muted); font-size: 12.5px; text-align: center; }

/* ---------- Приглашение поставить приложение ---------- */
.instbar {
  display: flex; align-items: center; gap: 10px;
  margin: 0 0 12px; padding: 9px 10px 9px 13px;
  border: 1px solid var(--panel-b); border-radius: 14px;
  background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 16%, transparent), var(--panel));
  backdrop-filter: blur(10px);
  animation: instIn .45s var(--ease);
}
@supports not (background: color-mix(in srgb, red 50%, blue)) {
  .instbar { background: var(--panel); }
}
.instbar .ic { display: flex; color: var(--accent2); flex: 0 0 auto; }
.instbar .ic .i { width: 19px; height: 19px; }
.instbar .t { flex: 1; min-width: 0; font-size: 13px; font-weight: 700; line-height: 1.3; color: var(--text); }
.instbar .go {
  flex: 0 0 auto; padding: 7px 13px; border-radius: 11px;
  background: var(--accent); color: #fff;
  font: 800 12.5px/1 var(--font-ui); letter-spacing: .2px;
  cursor: pointer; transition: transform .15s var(--ease), filter .2s;
}
.instbar .go:hover { filter: brightness(1.08); }
.instbar .go:active { transform: scale(.96); }
.instbar .x { flex: 0 0 auto; width: 28px; height: 28px; display: grid; place-items: center; color: var(--muted); border-radius: 9px; cursor: pointer; }
.instbar .x:hover { color: var(--text); background: var(--panel); }
.instbar .x .i { width: 15px; height: 15px; }
@keyframes instIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

/* Информационная плашка от владельца сайта — та же форма, другой оттенок. */
.msgbar { background: linear-gradient(90deg, color-mix(in srgb, var(--accent2) 18%, transparent), var(--panel)); }
@supports not (background: color-mix(in srgb, red 50%, blue)) { .msgbar { background: var(--panel); } }
.msgbar .ic { color: var(--accent); }
.msgbar .t { font-weight: 600; }
.msgbar .go { background: var(--accent2); color: #06121a; text-decoration: none; display: inline-flex; align-items: center; }
@media (max-width: 420px) { .instbar .t { font-size: 11.8px; } .instbar .go { padding: 7px 11px; } }

.inst-plus { display: grid; gap: 9px; margin: 14px 0 4px; }
.inst-plus > div { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 13.5px; line-height: 1.4; }
.inst-plus .i { width: 17px; height: 17px; color: var(--accent2); flex: 0 0 auto; }
.inst-steps { margin: 14px 0 4px; padding-left: 22px; color: var(--muted); font-size: 13.5px; line-height: 1.55; }
.inst-steps li { margin: 7px 0; }
.inst-steps b { color: var(--text); }
.foot-app { margin: 2px 0 4px; }
.foot-app .linkbtn { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; }
.foot-app .linkbtn .i { width: 15px; height: 15px; }

a.btn { text-decoration: none; }

/* Переносы: не оставляем одинокое слово на последней строке (там, где браузер умеет) */
.hint, .sub, .rules li, .inst-steps li, .inst-plus > div { text-wrap: pretty; }
.hint + .stack { margin-top: 12px; }

/* ---------- Знак «Словоплёт» вместо прежней плитки «5» ---------- */
/* Знак «Словоплёт»: иконка целиком, с подложкой. Наклон и покачивание от
   прежней плитки «5» остаются — карточке они идут, а узлу без фона не шли. */
.logo.mark {
  background: url('icons/icon-192.png') center / cover no-repeat;
  color: transparent; font-size: 0; text-indent: -9999px;
}
.bt-logo.mark { width: 88px; height: 88px; border-radius: 26px; }

/* ---------- Окно обновления приложения ---------- */
.lb-guest { margin: 14px 0 0; padding-top: 14px; border-top: 1px solid var(--panel-b); }
.lb-guest p { margin: 0 0 10px; color: var(--muted); font-size: 14px; line-height: 1.5; text-wrap: pretty; }
.upd-notes { margin: 14px 0 4px; color: var(--muted); font-size: 14px; line-height: 1.55; text-wrap: pretty; }
.upd-notes .v { margin: 12px 0 6px; color: var(--text); font-weight: 800; font-size: 13px; letter-spacing: .3px; }
.upd-notes .v:first-child { margin-top: 0; }
.upd-notes ul { margin: 0; padding-left: 20px; }
.upd-notes li { margin: 5px 0; }
.upd-bar { height: 8px; border-radius: 99px; background: var(--panel); border: 1px solid var(--panel-b); overflow: hidden; margin: 14px 0 2px; }
.upd-bar i { display: block; height: 100%; width: 0; border-radius: 99px; background: linear-gradient(90deg, var(--accent), var(--accent2)); transition: width .3s var(--ease); }
body.upd-blocked #app { pointer-events: none; filter: blur(3px) saturate(.8); }

/* ---------- Код для телефона в окне установки ---------- */
.inst-qr { display: flex; align-items: center; gap: 16px; margin: 4px 0 16px; padding: 14px; border-radius: 18px; background: var(--panel); border: 1px solid var(--panel-b); }
.inst-qr .qr { flex: 0 0 auto; width: 128px; height: 128px; border-radius: 10px; background: #fff; padding: 6px; box-sizing: content-box; }
.inst-qr > div { min-width: 0; display: flex; flex-direction: column; gap: 5px; text-align: left; }
.inst-qr b { font-size: 15px; line-height: 1.25; }
.inst-qr span { font-size: 13px; line-height: 1.45; color: var(--muted); text-wrap: pretty; }
.inst-qr small { font-size: 11.5px; color: var(--muted); opacity: .75; word-break: break-all; }
@media (max-width: 460px) { .inst-qr { flex-direction: column; text-align: center; } .inst-qr > div { text-align: center; align-items: center; } }

/* ---------- Пауза: таймер остановился, пока игра была свёрнута ---------- */
.pause-t { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 6px 0 18px; padding: 14px; border-radius: 18px; background: var(--panel); border: 1px solid var(--panel-b); }
.pause-t .i { width: 22px; height: 22px; color: var(--muted); }
.pause-t b { font-size: 30px; font-variant-numeric: tabular-nums; letter-spacing: .5px; }

/* ---------- Витрина (главный экран) ----------
   Один и тот же экран на сайте и в приложении. Поле и боковая панель на нём
   прячутся, шапка остаётся: логотип в ней и работает кнопкой «домой». */
.home { flex: 1; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; text-align: center; overflow-y: auto; padding: 6px 0; }
body.home .play, body.home .side { display: none !important; }
/* Предложение поставить игру на витрине уже есть — в подвале оно лишнее. */
body.home .foot-app { display: none; }
.home-demo { display: flex; flex-direction: column; gap: 8px; --tile: min(56px, calc((100vw - 28px - 32px) / 5)); }
@media (min-height: 760px) { .home-demo { --tile: min(66px, calc((100vw - 28px - 32px) / 5)); } }
.hd-r { display: grid; grid-template-columns: repeat(5, var(--tile)); gap: 8px; }
/* Статичная картинка — то, чем ролик заканчивается: подсказки и разгаданное
   слово. От неё анимация только отталкивается, поэтому в «спокойном» режиме
   и при prefers-reduced-motion ничего дорисовывать не нужно. */
.hd-r .tile { --d-bg: var(--c-bg); --d-t: var(--c-t); border-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--d-bg); color: var(--d-t); }
.hd-r .tile[data-d="p"] { --d-bg: var(--p-bg); --d-t: var(--p-t); }
.hd-r .tile[data-d="a"] { --d-bg: var(--a-bg); --d-t: var(--a-t); }
body:not(.calm) .home-demo .tile { animation: hdA 10s var(--ease) infinite; animation-delay: calc(var(--i) * 160ms); }
body:not(.calm) .home-demo .hd-b .tile { animation-name: hdB; }
/* Три такта: набрали слово — буквы подсветились — слово разгадано. Цвет
   каждой плитки берётся из её же --d-bg, поэтому такт «подсветились» у разных
   плиток разный, а код один. Свойства перечислены в каждом кадре нарочно:
   пропущенное браузер тянет к следующему кадру, где оно есть, и такт плывёт. */
@keyframes hdA {
  0%, 2%    { background: var(--tile-bg); border-color: var(--tile-b);  color: transparent;  transform: scale(.94); }
  6%        { background: var(--tile-bg); border-color: var(--accent2); color: var(--text);  transform: scale(1.08); }
  10%, 24%  { background: var(--tile-bg); border-color: var(--tile-bf); color: var(--text);  transform: scale(1); }
  28%       { background: var(--tile-bg); border-color: var(--tile-bf); color: var(--text);  transform: rotateX(88deg); }
  33%, 82%  { background: var(--d-bg);    border-color: transparent;    color: var(--d-t);   transform: rotateX(0); }
  90%, 100% { background: var(--tile-bg); border-color: var(--tile-b);  color: transparent;  transform: scale(.94); }
}
@keyframes hdB {
  0%, 40%   { background: var(--tile-bg); border-color: var(--tile-b);  color: transparent; transform: scale(.94); }
  45%       { background: var(--tile-bg); border-color: var(--accent2); color: var(--text); transform: scale(1.08); }
  49%, 58%  { background: var(--tile-bg); border-color: var(--tile-bf); color: var(--text); transform: scale(1); }
  62%       { background: var(--tile-bg); border-color: var(--tile-bf); color: var(--text); transform: rotateX(88deg); }
  66%       { background: var(--d-bg);    border-color: transparent;    color: var(--d-t);  transform: rotateX(0); }
  72%       { background: var(--d-bg);    border-color: transparent;    color: var(--d-t);  transform: translateY(-14px); }
  78%, 86%  { background: var(--d-bg);    border-color: transparent;    color: var(--d-t);  transform: translateY(0); }
  94%, 100% { background: var(--tile-bg); border-color: var(--tile-b);  color: transparent; transform: scale(.94); }
}
/* Верх и низ прижаты автоматическими отступами: блок встаёт по центру
   свободного места и не оставляет дыры под собой на вытянутом экране. */
.home-intro { margin: auto 0 0; }
.home-kicker { margin: 0 0 12px; font-size: 10.5px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
/* margin-inline: auto обязателен везде, где есть max-width: эти блоки лежат
   внутри .home-intro — обычного блока, а не флекса, и без автоотступов
   прижимаются к его левому краю. Подпись из-за этого стояла на два десятка
   точек левее заголовка. */
.home-title { margin: 0 auto; font: 800 clamp(27px, 8vw, 40px)/1.12 var(--font-tile); letter-spacing: -.02em; max-width: 15ch; text-wrap: balance; }
.home-sub { margin: 14px auto 0; font-size: 14px; line-height: 1.55; color: var(--muted); max-width: 32ch; text-wrap: pretty; }
.home-cap { margin: 12px 0 0; font-size: 11.5px; color: var(--muted); }
.home-acts { width: 100%; max-width: 360px; }
.btn.hbig { height: 58px; font-size: 19px; }
.home-stat { min-height: 16px; margin: 10px 0 0; font-size: 11.5px; color: var(--muted); }
/* Разделы — переходы, а не предложения: им хватает строки компактных кнопок. */
.home-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 440px; }
.hbtn {
  display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 11px 15px;
  border-radius: 14px; font-size: 13px; font-weight: 700;
  background: var(--panel); border: 1px solid var(--panel-b);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  transition: transform .18s var(--ease), box-shadow .2s;
}
.hbtn:hover { transform: translateY(-2px); box-shadow: 0 10px 22px -12px var(--glow); }
.hbtn:active { transform: scale(.96); }
.hbtn .i { width: 17px; height: 17px; color: var(--accent2); }
.home-foot { display: flex; flex-direction: column; align-items: center; gap: 6px; margin: 0 0 auto; font-size: 11.5px; color: var(--muted); }
/* Строка версии — ещё и скрытая дверь в админку (семь нажатий). Сама строка
   тонкая, поэтому расширяем область нажатия, не меняя вид: попасть семь раз
   подряд по 15 точкам высоты на телефоне невозможно. */
#home-ver { padding: 10px 18px; margin: -10px -18px; cursor: default; }
.home-foot .linkbtn { display: inline-flex; align-items: center; gap: 7px; font-size: 12.5px; }
.home-foot .linkbtn .i { width: 15px; height: 15px; }
@media (max-height: 640px) {
  .home { gap: 10px; } .home-demo { --tile: 40px; }
  .home-kicker { display: none; } .home-sub { display: none; } .home-cap { display: none; }
  .btn.hbig { height: 52px; font-size: 17px; } .hbtn { min-height: 40px; padding: 9px 12px; font-size: 12px; }
}
@media (min-width: 700px) and (min-height: 600px) {
  .home { gap: 22px; } .home-demo { --tile: 68px; gap: 10px; } .hd-r { gap: 10px; }
  .home-kicker { font-size: 12px; } .home-sub { font-size: 16px; } .home-cap { font-size: 13px; }
  .home-acts { max-width: 420px; } .btn.hbig { height: 64px; font-size: 21px; }
  .home-stat { font-size: 13px; } .hbtn { font-size: 14px; padding: 12px 18px; }
}
/* На широком экране витрина — обычная страница в колонку, а не левая
   колонка игровой сетки: иначе шапка стоит отдельно от того, что под ней. */
@media (min-width: 1000px) and (min-height: 600px) {
  .home { grid-column: 1 / -1; grid-row: 2; }
  body.home #app { display: flex; flex-direction: column; max-width: 820px; }
  body.home #b-lb, body.home #b-user { display: grid; }
}
@media (prefers-reduced-motion: reduce) { .home-demo .tile { animation: none !important; } }

/* ---------- Кто сейчас в игре: огонёк в рейтинге ---------- */
.lb-live { display: flex; align-items: center; gap: 8px; margin: -6px 0 14px; font-size: 12.5px; color: var(--muted); }
.lb-live .on { flex: none; margin-right: 0; }
.lbr .nm .on, .lb-live .on {
  display: inline-block; width: 8px; height: 8px; margin-right: 7px; border-radius: 50%;
  background: var(--ok); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent);
  vertical-align: middle; animation: onPulse 2.4s ease-in-out infinite;
}
@keyframes onPulse { 50% { opacity: .45; } }
body.calm .lbr .nm .on, body.calm .lb-live .on { animation: none; }
@media (prefers-reduced-motion: reduce) { .lbr .nm .on, .lb-live .on { animation: none !important; } }

/* ---------- Характер игры: реплика облачком ----------
   Своим слоем поверх поля, а не в общей стопке уведомлений: иначе реплика
   ложилась вторым этажом на сообщение об ошибке. Облачко встаёт у случайного
   края на случайной высоте, слегка набок — будто его туда прилепили, а не
   выровняла вёрстка. Уходит, лопаясь облачком дыма. */
#says { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
.say {
  position: absolute; max-width: min(62%, 240px);
  padding: 12px 16px; border-radius: 18px;
  background: var(--sheet); color: var(--text);
  border: 1px solid color-mix(in srgb, var(--accent2) 55%, transparent);
  font: 700 14.5px/1.4 var(--font-ui); white-space: pre-line;
  box-shadow: 0 18px 40px -14px rgba(0,0,0,.65), 0 0 30px -12px var(--glow);
  transform-origin: var(--ox, 0%) 80%;
  animation: sayIn .42s var(--ease) both;
}
.say.l { left: 2%; border-bottom-left-radius: 6px; --ox: 8%; }
.say.r { right: 2%; border-bottom-right-radius: 6px; --ox: 92%; }
/* Хвостик облачка — кружок у нижнего угла, со стороны поля. */
.say::after {
  content: ''; position: absolute; bottom: -7px; width: 11px; height: 11px; border-radius: 50%;
  background: var(--sheet); border: 1px solid color-mix(in srgb, var(--accent2) 55%, transparent);
}
.say.l::after { left: 14px; }
.say.r::after { right: 14px; }
@keyframes sayIn {
  0%   { opacity: 0; transform: scale(.2) rotate(var(--rot, 0deg)); }
  60%  { opacity: 1; transform: scale(1.06) rotate(var(--rot, 0deg)); }
  100% { opacity: 1; transform: scale(1) rotate(var(--rot, 0deg)); }
}
.say.pop { animation: sayPop .52s var(--ease) forwards; }
@keyframes sayPop {
  0%   { opacity: 1; transform: scale(1) rotate(var(--rot, 0deg)); filter: blur(0); }
  40%  { opacity: .9; transform: scale(1.12) rotate(var(--rot, 0deg)); }
  100% { opacity: 0; transform: scale(1.3) rotate(var(--rot, 0deg)); filter: blur(7px); }
}
.say i {
  position: absolute; left: 50%; top: 50%; width: 11px; height: 11px; border-radius: 50%;
  background: color-mix(in srgb, var(--accent2) 70%, #fff); opacity: 0;
}
.say.pop i { animation: sayPuff .6s var(--ease) forwards; animation-delay: calc(var(--i) * 28ms); }
@keyframes sayPuff {
  0%   { opacity: .85; transform: translate(-50%, -50%) scale(.5); }
  100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.5); }
}
/* В спокойном режиме — просто появилось и просто исчезло. */
body.calm .say { animation: sayFade .2s both; }
body.calm .say.pop { animation: sayFadeOut .2s forwards; }
body.calm .say i { display: none; }
@keyframes sayFade { from { opacity: 0; } }
@keyframes sayFadeOut { to { opacity: 0; } }
@media (prefers-reduced-motion: reduce) {
  .say { animation: sayFade .2s both !important; }
  .say.pop { animation: sayFadeOut .2s forwards !important; }
  .say i { display: none; }
}
/* ---------- Смена пароля в профиле ---------- */
.pw { display: flex; flex-direction: column; gap: 10px; margin: 10px 0 12px; }
.pw .msg:empty { display: none; }

.res-quip { margin: 10px 0 0; font-size: 14px; color: var(--muted); font-style: italic; text-wrap: pretty; }
.tile.fall { animation: tileFall .55s var(--ease) forwards; }
@keyframes tileFall { to { transform: translateY(26px) rotate(8deg); opacity: 0; } }
body.calm .tile.fall { animation: none; }
